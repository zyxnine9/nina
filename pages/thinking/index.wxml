<t-navbar title="思维方式" left-arrow />
<view class="page page--thinking">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="dots" size="40rpx" text="正在回看你的思考轨迹" />
  </view>

  <view wx:elif="{{failed}}" class="state-wrap">
    <view class="state-text">这个维度暂时没加载出来。</view>
    <view class="btn-retry" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <!-- 正在形成（主动评论不足） -->
    <view wx:if="{{forming}}" class="forming-card">
      <view class="forming-card__title">你的思维轨迹正在形成</view>
      <view class="forming-card__desc">在书页旁写下更多想法与回应，NINA 才能看清你反复出现的思考方式。</view>
    </view>

    <block wx:else>
      <!-- 场景 hero：拱门里的思考者 + 依据 + 衬线核心判断 -->
      <view class="hero">
        <image class="hero__scene" src="/images/thinking-scene.png" mode="aspectFill" />
        <view class="hero__fade"></view>
        <view class="hero__copy">
          <view wx:if="{{basisText}}" class="hero__basis">{{basisText}}</view>
          <view wx:if="{{summary}}" class="hero__headline">{{summary}}</view>
        </view>
      </view>

      <view class="content">
        <view class="section-heading">你与书的对话</view>

        <view
          class="block {{index === items.length - 1 ? 'block--last' : ''}}"
          wx:for="{{items}}"
          wx:for-item="dim"
          wx:key="id"
        >
          <!-- 竖条 + 思维方式名 + 描述 -->
          <view class="block__head">
            <view class="block__bar"></view>
            <view class="block__headbody">
              <view class="block__name">{{dim.name}}</view>
              <view class="block__desc">{{dim.description}}</view>
            </view>
          </view>

          <!-- 对话双卡：左「书里说」白卡 / 右「你回应」蓝卡下错位 -->
          <view wx:if="{{dim.lead}}" class="dialogue {{dim.lead.sourceText ? '' : 'dialogue--solo'}}">
            <view wx:if="{{dim.lead.sourceText}}" class="qcard qcard--book" bindtap="onEvidenceTap">
              <view class="qcard__kicker">
                <t-icon name="book-open" size="28rpx" color="#5d86bd" />
                <text>书里说</text>
              </view>
              <view class="qcard__quote">"{{dim.lead.sourceText}}"</view>
              <view wx:if="{{dim.lead.bookTitle}}" class="qcard__source">《{{dim.lead.bookTitle}}》</view>
            </view>
            <view class="qcard qcard--reader" bindtap="onEvidenceTap">
              <view class="qcard__kicker">
                <t-icon name="user" size="26rpx" color="#5d86bd" />
                <text>你回应</text>
              </view>
              <view class="qcard__reply">{{dim.lead.userResponse}}</view>
              <view wx:if="{{dim.lead.sourceText && dim.lead.bookTitle}}" class="qcard__source">《{{dim.lead.bookTitle}}》</view>
            </view>
          </view>

          <!-- 洞察条 -->
          <view class="insight">
            <view class="insight__icon">
              <t-icon name="{{dim.insightIcon}}" size="34rpx" color="#6494db" />
            </view>
            <view class="insight__body">
              <view class="insight__strong">{{dim.name}}</view>
              <view class="insight__sub">{{dim.momentCount ? '这种方式还出现于 ' + dim.momentCount + ' 条阅读记录' : '来自你的真实阅读记录'}}</view>
            </view>
            <view
              wx:if="{{dim.more.length}}"
              class="text-action {{dim.expanded ? 'text-action--open' : ''}}"
              data-id="{{dim.id}}"
              catchtap="onExpandTap"
            >{{dim.expanded ? '收起证据' : '查看更多证据'}}</view>
          </view>

          <!-- 展开的更多证据 -->
          <view wx:if="{{dim.expanded && dim.more.length}}" class="evidence-more">
            <view class="evidence-more__row" wx:for="{{dim.more}}" wx:for-item="ev" wx:key="sourceMomentId">
              <text class="evidence-more__book">《{{ev.bookTitle}}》</text>
              <text class="evidence-more__text">{{ev.userResponse || ev.sourceText}}</text>
            </view>
          </view>
        </view>

        <view class="thinking-footer" bindtap="onMoreTap">
          继续查看思维证据
          <t-icon name="chevron-right" size="24rpx" color="#6d8db8" />
        </view>
      </view>
    </block>
  </block>

  <t-toast id="t-toast" />
</view>
