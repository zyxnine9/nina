<t-navbar title="思维方式" left-arrow />
<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="dots" size="40rpx" text="正在回看你的思考轨迹" />
  </view>

  <view wx:elif="{{failed}}" class="state-wrap">
    <view class="state-text">这个维度暂时没加载出来。</view>
    <view class="btn-retry" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <!-- 正在形成（主动评论不足） -->
    <block wx:if="{{forming}}">
      <view class="forming-card">
        <view class="forming-card__title">你的思维轨迹正在形成</view>
        <view class="forming-card__desc">在书页旁写下更多想法与回应，NINA 才能看清你反复出现的思考方式。</view>
      </view>
    </block>

    <block wx:else>
      <!-- 依据 + 核心判断（衬线） -->
      <view wx:if="{{basisText}}" class="basis">{{basisText}}</view>
      <view wx:if="{{summary}}" class="headline">{{summary}}</view>

      <view class="section-title">你与书的对话</view>

      <view class="think-card" wx:for="{{items}}" wx:for-item="dim" wx:key="id">
        <view class="think-card__name">{{dim.name}}</view>
        <view class="think-card__desc">{{dim.description}}</view>

        <!-- 对话式证据：左「书里说」白卡 / 右「你回应」蓝卡下错位 -->
        <view
          wx:for="{{dim.evidenceGroups}}"
          wx:for-item="g"
          wx:key="sourceMomentId"
          class="dialog {{g.sourceText ? '' : 'dialog--solo'}}"
        >
          <view wx:if="{{g.sourceText}}" class="say" bindtap="onEvidenceTap">
            <view class="say__head">
              <t-icon name="book-open" size="30rpx" color="#8fb3d9" />
              <text class="say__who">书里说</text>
            </view>
            <view class="say__quote">“ {{g.sourceText}} ”</view>
            <view wx:if="{{g.bookTitle}}" class="say__meta">——《{{g.bookTitle}}》</view>
          </view>
          <view class="reply" bindtap="onEvidenceTap">
            <view class="reply__head">
              <t-icon name="user" size="28rpx" color="#7ba7d4" />
              <text class="reply__who">你回应</text>
            </view>
            <view class="reply__text">{{g.userResponse}}</view>
            <view wx:if="{{g.bookTitle}}" class="reply__meta">《{{g.bookTitle}}》</view>
          </view>
        </view>

        <view class="think-card__foot">
          <view class="think-card__count">
            <t-icon name="tips" size="30rpx" color="#9db8d4" />
            <text wx:if="{{dim.momentCount}}">这种方式还出现于 {{dim.momentCount}} 条阅读记录</text>
            <text wx:else>来自你的真实阅读记录</text>
          </view>
          <view class="think-card__more" catchtap="onMoreTap">查看更多证据 ›</view>
        </view>
      </view>
    </block>
  </block>

  <t-toast id="t-toast" />
</view>
