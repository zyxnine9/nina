<view class="discover-page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="dots" size="40rpx" text="NINA 正在努力认识你" />
  </view>

  <block wx:else>
    <!-- 1. Hero 景观区 -->
    <view class="scene" style="padding-top: {{statusBarHeight}}px;">
      <view class="landscape">
        <image class="landscape__image" src="/images/nina-arch.jpg" mode="aspectFill" />
        <view class="landscape__cover"></view>
        <view class="landscape__mist landscape__mist--far"></view>
        <view class="landscape__light"></view>
      </view>

      <view class="brand-row">
        <view class="brand">
          <text class="brand-name">NINA</text>
          <text class="brand-sub">看见自己</text>
        </view>
      </view>

      <view class="copy">
        <view class="copy-title">你读过的每一本书</view>
        <view class="copy-title">都在悄悄塑造现在的你</view>
        <view class="copy-desc">通过阅读数据，发现你的兴趣、思维和未被看见的自己。</view>
      </view>
    </view>

    <!-- 2. 画像卡 -->
    <view class="stage" id="portrait">
      <view class="portrait-card">
        <view class="card-glow"></view>

        <view class="portrait-header">
          <text class="portrait-title">我的阅读画像</text>
        </view>

        <view class="personas">
          <view
            wx:for="{{personas}}"
            wx:key="tagId"
            class="persona persona--{{item.tone}} {{activePersona === item.tagId ? 'is-active' : ''}}"
            data-tag-id="{{item.tagId}}"
            data-name="{{item.name}}"
            data-tone="{{item.tone}}"
            data-icon="{{item.icon}}"
            bindtap="onPersonaTap"
          >
            <text class="persona-icon">{{item.icon}}</text>
            <text class="persona-name">{{item.name}}</text>
          </view>
        </view>

        <view class="intro">基于你的阅读数据，AI 为你生成了 6 个维度的分析，快来看看，你在书中藏着怎样的自己吧～</view>

        <!-- 知识宇宙 -->
        <view class="universe {{paused ? 'universe--paused' : ''}}">
          <view class="orbit orbit--one"></view>
          <view class="orbit orbit--two"></view>
          <view class="orbit orbit--three"></view>
          <view class="satellite sat-1"></view>
          <view class="satellite sat-2"></view>
          <view class="satellite sat-3"></view>
          <view class="satellite sat-4"></view>
          <view class="satellite sat-5"></view>
          <view class="satellite sat-6"></view>

          <view
            wx:for="{{bubbles}}"
            wx:key="id"
            class="bubble bubble--{{item.variant}}"
            style="{{item.animStyle}}"
            data-id="{{item.id}}"
            data-variant="{{item.variant}}"
            data-name="{{item.name}}"
            data-percent="{{item.percent}}"
            bindtap="onBubbleTap"
          >
            <text class="bubble-name">{{item.name}}</text>
            <text class="bubble-percent">{{item.percent}}%</text>
          </view>

          <view class="core" bindtap="onCoreTap">
            <view class="core__liquid"></view>
            <view class="core__shine"></view>
            <text class="core-text">你的知识{{'\n'}}结构</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <t-toast id="t-toast" />
</view>
