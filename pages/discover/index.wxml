<view class="discover-page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="dots" size="40rpx" text="NINA 正在努力认识你" />
  </view>

  <block wx:else>
    <!-- 1. Hero：品牌头 + 标语 + 拱门插画 -->
    <view class="hero" style="padding-top: {{statusBarHeight}}px;">
      <view class="hero-arch"></view>
      <view class="nav-row">
        <view class="brand">
          <text class="brand-name">NINA</text>
          <text class="brand-sub">看见自己</text>
        </view>
        <view class="nav-search" style="right: {{searchRight}}px;" bindtap="onSearchTap">
          <t-icon name="search" size="22px" color="#1a1d24" />
        </view>
      </view>
      <view class="hero-slogan">
        <view class="slogan-line">你读过的每一本书</view>
        <view class="slogan-line">都在悄悄塑造现在的你</view>
      </view>
      <view class="hero-desc">通过阅读数据，发现你的兴趣、思想和未被看见的自己。</view>
    </view>

    <!-- 2. 主体 -->
    <view class="body">
      <!-- 2.1 我的阅读画像 -->
      <view class="profile-card nina-card">
        <view class="card-head" bindtap="onFullAnalysisTap">
          <text class="card-title">我的阅读画像</text>
          <text class="card-link">查看完整分析 ›</text>
        </view>
        <view class="persona-chips">
          <view
            wx:for="{{personas}}"
            wx:key="tagId"
            class="persona-chip persona-{{item.tone}}"
            data-tag-id="{{item.tagId}}"
            bindtap="onPersonaTap"
          >
            <text class="persona-icon">{{item.icon}}</text>
            <text>{{item.name}}</text>
          </view>
        </view>
        <view class="profile-desc">基于你的阅读数据，AI 为你生成了 6 个维度的分析，快来看看，你在书中藏着怎样的自己～</view>
        <view wx:if="{{bubbles.length}}" class="bubble-wrap" bindtap="onCanvasTap">
          <canvas id="bubbleCanvas" type="2d" class="bubble-canvas"></canvas>
        </view>
      </view>

      <!-- 2.2 你可能感兴趣的领域 -->
      <view class="interest-card nina-card">
        <view class="card-head">
          <text class="card-title">✦ 你可能感兴趣的领域</text>
          <text class="card-link" bindtap="onMoreInterestTap">更多推荐 ›</text>
        </view>
        <view class="interest-chips">
          <view
            wx:for="{{interests}}"
            wx:key="id"
            class="chip"
            data-name="{{item.name}}"
            bindtap="onInterestTap"
          >{{item.name}}</view>
        </view>
      </view>
    </view>
  </block>

  <t-toast id="t-toast" />
</view>
