<view class="explore-page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="dots" size="40rpx" text="正在翻开这本关于你的书" />
  </view>

  <block wx:else>
    <view class="page-header">
      <view class="page-title">探索</view>
      <view class="page-subtitle">这是一本关于我的书</view>
    </view>

    <view wx:if="{{dimensions.length}}" class="dim-list">
      <view
        wx:for="{{dimensions}}"
        wx:key="key"
        class="dim-item nina-card"
        data-key="{{item.key}}"
        data-title="{{item.title}}"
        bindtap="onDimensionTap"
      >
        <view class="dim-head">
          <text class="dim-title">{{item.title}}</text>
          <text class="dim-arrow">›</text>
        </view>
        <view class="dim-oneline">{{item.preview || item.oneLine}}</view>
      </view>
    </view>
    <view wx:else class="empty-wrap">
      <view class="empty-text">这本关于你的书，正在书写第一章。</view>
    </view>
  </block>

  <t-toast id="t-toast" />
</view>
