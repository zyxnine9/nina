<t-navbar title="阅读人格" left-arrow />
<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="dots" size="40rpx" text="正在描绘你的阅读气质" />
  </view>

  <view wx:elif="{{failed}}" class="state-wrap">
    <view class="state-text">这个维度暂时没加载出来。</view>
    <view class="btn-retry" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <view wx:if="{{basisText}}" class="basis">{{basisText}}</view>

    <!-- 人物原型：framing + 名字 + 气质句 -->
    <block wx:if="{{archetype}}">
      <view class="arch-hero">
        <view class="arch-hero__aura"></view>
        <view class="arch-hero__framing">{{archetype.framing}}</view>
        <view class="arch-hero__name">{{titleText}}</view>
        <view wx:if="{{summary}}" class="arch-hero__summary">{{summary}}</view>
      </view>

      <!-- 你与 TA 相似的地方 -->
      <view class="section-title">你与 TA 相似的地方</view>
      <view class="trait-list">
        <view class="trait" wx:for="{{traits}}" wx:key="name">
          <view class="trait__body">
            <view class="trait__name">{{item.name}}</view>
            <view class="trait__desc">{{item.description}}</view>
            <view wx:if="{{item.behaviorEvidence.length}}" class="trait__evidence">
              <text wx:for="{{item.behaviorEvidence}}" wx:for-item="ev" wx:key="*this" class="trait__chip">{{ev}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 人物证据不足：只呈现行为节律 -->
    <block wx:if="{{!archetype}}">
      <view class="forming-card">
        <view class="forming-card__title">你的人物原型正在浮现</view>
        <view wx:if="{{summary}}" class="forming-card__desc">{{summary}}</view>
        <view wx:else class="forming-card__desc">再多读一些书，NINA 会为你找到那个遥遥呼应的人物。</view>
      </view>
    </block>

    <!-- 你的阅读一天：行为节律 -->
    <view wx:if="{{rhythm.length}}" class="section-title">{{archetype ? '你的阅读一天' : '你的阅读节律'}}</view>
    <view wx:if="{{rhythm.length}}" class="rhythm">
      <view class="rhythm__item" wx:for="{{rhythm}}" wx:key="label">
        <view class="rhythm__value">{{item.value}}</view>
        <view class="rhythm__label">{{item.label}}</view>
      </view>
    </view>

    <!-- 这像你吗？ -->
    <view class="feedback">
      <view class="feedback__title">这像你吗？</view>
      <view class="feedback__pills">
        <view
          class="pill {{myFeedback === 'like' ? 'pill--active' : ''}}"
          data-type="like"
          bindtap="onFeedbackTap"
        >很像你</view>
        <view
          class="pill {{myFeedback === 'somewhat' ? 'pill--active' : ''}}"
          data-type="somewhat"
          bindtap="onFeedbackTap"
        >一部分像</view>
        <view
          class="pill {{myFeedback === 'dislike' ? 'pill--active' : ''}}"
          data-type="dislike"
          bindtap="onFeedbackTap"
        >不太像你</view>
      </view>
    </view>
  </block>

  <t-toast id="t-toast" />
</view>
