<t-navbar title="未读之境" left-arrow />
<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="dots" size="40rpx" text="正在寻找你的新方向" />
  </view>

  <view wx:elif="{{failed}}" class="state-wrap">
    <view class="state-text">这个维度暂时没加载出来。</view>
    <view class="btn-retry" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <view class="headline">三个你可能会喜欢的新方向</view>

    <!-- 正在形成 -->
    <view wx:if="{{forming}}" class="forming-card">
      <view class="forming-card__title">你的未读之境正在展开</view>
      <view class="forming-card__desc">再积累一些阅读足迹，NINA 会为你找到与已有兴趣相连的新方向。</view>
    </view>

    <!-- 三张纵向错落的“远方入口”卡片（手风琴） -->
    <block wx:else>
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="realm realm--spec{{item.spec}} {{expandedId === item.id ? 'realm--open' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCardTap"
      >
        <view class="realm__head">
          <view class="realm__name">{{item.name}}</view>
          <view class="realm__affinity">{{item.affinityLabel}}</view>
        </view>

        <block wx:if="{{expandedId === item.id}}">
          <view wx:if="{{item.intro}}" class="realm__intro">{{item.intro}}</view>
          <view wx:if="{{item.reason}}" class="realm__reason">{{item.reason}}</view>

          <!-- 与已有兴趣的连接 -->
          <view wx:if="{{item.connections.length}}" class="realm__section">
            <view class="realm__section-title">与你的兴趣相连</view>
            <view class="conn-list">
              <view
                wx:for="{{item.connections}}"
                wx:for-item="conn"
                wx:key="name"
                class="conn"
                catchtap="onConnectionTap"
              >{{conn.name}}</view>
            </view>
          </view>

          <!-- 主要进入方式 -->
          <view wx:if="{{item.entry}}" class="realm__section">
            <view class="realm__section-title">从这里开始</view>
            <view class="entry">
              <view class="entry__title">{{item.entry.title}}</view>
              <view wx:if="{{item.entryBooks.length}}" class="entry__books">
                <block wx:for="{{item.entryBooks}}" wx:for-item="bk" wx:key="bookId">
                  <image wx:if="{{bk.cover}}" class="entry__cover" src="{{bk.cover}}" mode="aspectFill" />
                  <view wx:else class="entry__cover entry__cover--empty">书</view>
                </block>
              </view>
              <view
                class="entry__start"
                data-type="{{item.entry.type}}"
                catchtap="onStartTap"
              >从这里开始</view>
            </view>
          </view>

          <!-- 轻量反馈 -->
          <view class="fb">
            <view
              class="fb__pill {{item.myFeedback === 'interested' ? 'fb__pill--active' : ''}}"
              data-id="{{item.id}}"
              data-type="interested"
              catchtap="onFeedbackTap"
            >想了解</view>
            <view
              class="fb__pill {{item.myFeedback === 'not_interested' ? 'fb__pill--active' : ''}}"
              data-id="{{item.id}}"
              data-type="not_interested"
              catchtap="onFeedbackTap"
            >暂时没兴趣</view>
            <view
              class="fb__pill {{item.myFeedback === 'already_read' ? 'fb__pill--active' : ''}}"
              data-id="{{item.id}}"
              data-type="already_read"
              catchtap="onFeedbackTap"
            >其实我读过</view>
          </view>
        </block>
      </view>
    </block>
  </block>

  <t-toast id="t-toast" />
</view>
