<t-navbar title="未读之境" left-arrow />
<view class="page page--unread">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="dots" size="40rpx" text="正在寻找你的新方向" />
  </view>

  <view wx:elif="{{failed}}" class="state-wrap">
    <view class="state-text">这个维度暂时没加载出来。</view>
    <view class="btn-retry" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <!-- 场景 hero：三扇远方拱门 -->
    <view class="hero">
      <image class="hero__scene" src="/images/unread-scene.png" mode="aspectFill" />
      <view class="hero__fade"></view>
      <view class="hero__copy">
        <view class="hero__headline">
          <view>三个你可能会喜欢</view>
          <view>的新方向</view>
        </view>
        <view class="hero__sub">
          <view>它们尚未出现在你的阅读里，</view>
          <view>却与你已经关心的问题悄悄相连。</view>
        </view>
      </view>
    </view>

    <!-- 正在形成 -->
    <view wx:if="{{forming}}" class="forming-card">
      <view class="forming-card__title">你的未读之境正在展开</view>
      <view class="forming-card__desc">再积累一些阅读足迹，NINA 会为你找到与已有兴趣相连的新方向。</view>
    </view>

    <!-- 手风琴卡片：迷你拱门 + 收起态副标题 / 展开详情 -->
    <view wx:else class="content">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="realm {{expandedId === item.id ? 'realm--open' : ''}}"
      >
        <view class="realm__summary" data-id="{{item.id}}" bindtap="onCardTap">
          <image class="realm__portal" src="{{item.portal}}" mode="aspectFill" />
          <view class="realm__name">
            <view class="realm__titlerow">
              <text class="realm__title">{{item.name}}</text>
              <view wx:if="{{item.affinityLabel}}" class="match-tag match-tag--{{item.tagSpec}}">
                <t-icon name="{{item.tagIcon}}" size="22rpx" color="{{item.tagColor}}" />
                <text>{{item.affinityLabel}}</text>
              </view>
            </view>
            <view wx:if="{{item.subtitle}}" class="realm__subtitle">{{item.subtitle}}</view>
          </view>
          <view class="realm__chevron">
            <t-icon name="chevron-right" size="26rpx" color="#7288a4" />
          </view>
        </view>

        <view wx:if="{{expandedId === item.id}}" class="realm__details">
          <view class="realm__rationale">
            <view class="realm__h3">为什么可能适合你</view>
            <view class="realm__why">{{item.reason || item.intro}}</view>
            <view wx:if="{{item.connections.length}}" class="links">
              <view
                class="link"
                wx:for="{{item.connections}}"
                wx:for-item="conn"
                wx:key="name"
                catchtap="onConnectionTap"
              >{{conn.name}}</view>
            </view>
          </view>

          <view class="realm__h3">从这里开始</view>
          <view wx:if="{{item.entry}}" class="entry" catchtap="onStartTap">
            <t-icon name="book-open" size="34rpx" color="#123a6b" />
            <view class="entry__body">
              <text class="entry__label">{{item.entry.label}}</text>
              <text class="entry__q">{{item.entry.q}}</text>
            </view>
            <t-icon name="chevron-right" size="30rpx" color="#7288a4" />
          </view>

          <view wx:if="{{item.entry}}" class="primary-action" catchtap="onStartTap">
            从这里开始
            <t-icon name="chevron-right" size="26rpx" color="#ffffff" />
          </view>

          <view class="fb">
            <view
              class="fb__pill {{item.myFeedback === 'interested' ? 'fb__pill--active' : ''}}"
              data-id="{{item.id}}"
              data-type="interested"
              catchtap="onFeedbackTap"
            >
              <t-icon name="heart" size="26rpx" color="{{item.myFeedback === 'interested' ? '#1d7566' : '#60738f'}}" />
              <text>想了解</text>
            </view>
            <view
              class="fb__pill {{item.myFeedback === 'not_interested' ? 'fb__pill--active' : ''}}"
              data-id="{{item.id}}"
              data-type="not_interested"
              catchtap="onFeedbackTap"
            >
              <t-icon name="minus-circle" size="26rpx" color="{{item.myFeedback === 'not_interested' ? '#1d7566' : '#60738f'}}" />
              <text>暂时没兴趣</text>
            </view>
            <view
              class="fb__pill {{item.myFeedback === 'already_read' ? 'fb__pill--active' : ''}}"
              data-id="{{item.id}}"
              data-type="already_read"
              catchtap="onFeedbackTap"
            >
              <t-icon name="check-circle" size="26rpx" color="{{item.myFeedback === 'already_read' ? '#1d7566' : '#60738f'}}" />
              <text>其实我读过</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <t-toast id="t-toast" />
</view>
