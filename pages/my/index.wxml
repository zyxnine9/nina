<view class="my-page">
  <view class="page-title">我的</view>

  <!-- 头部：头像（点击拉起微信头像选择） + 昵称（微信昵称快捷填写） -->
  <view class="nina-card user-card">
    <button
      class="avatar-btn"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
    >
      <image wx:if="{{profile.avatar}}" class="avatar-img" src="{{profile.avatar}}" mode="aspectFill" />
      <view wx:else class="avatar">{{profile.nickname && profile.nickname !== 'NINA 用户' ? profile.nickname[0] : 'N'}}</view>
    </button>
    <view class="user-meta">
      <input
        class="nickname-input"
        type="nickname"
        value="{{profile.nickname === 'NINA 用户' ? '' : profile.nickname}}"
        placeholder="NINA 用户"
        placeholder-class="nickname-placeholder"
        bindblur="onNicknameBlur"
      />
      <view class="page-subtitle">微信读书 · 自我探索</view>
    </view>
  </view>

  <!-- Key 状态卡 -->
  <view class="nina-card key-card">
    <view wx:if="{{profile.loading}}" class="key-loading">加载中…</view>

    <block wx:elif="{{!profile.hasKey}}">
      <view class="key-row">
        <view class="dot none"></view>
        <view class="key-title">未绑定微信读书 KEY</view>
      </view>
      <view class="key-desc">绑定后 NINA 才能读取你的阅读数据</view>
      <button class="btn-primary key-btn" bindtap="onBindKey">去绑定</button>
    </block>

    <block wx:elif="{{profile.keyStatus === 'expired'}}">
      <view class="key-row">
        <view class="dot expired"></view>
        <view class="key-title">KEY 已失效</view>
      </view>
      <view wx:if="{{profile.keyHint}}" class="key-hint">{{profile.keyHint}}</view>
      <view class="key-desc">KEY 已过期，重新绑定后将继续导入并重新分析</view>
      <button class="btn-primary key-btn" bindtap="onReplaceKey">重新绑定</button>
    </block>

    <block wx:else>
      <view class="key-row">
        <view class="dot valid"></view>
        <view class="key-title">KEY 已绑定</view>
      </view>
      <view wx:if="{{profile.keyHint}}" class="key-hint">{{profile.keyHint}}</view>
      <view wx:if="{{profile.keyUpdatedAtText}}" class="key-desc">绑定时间：{{profile.keyUpdatedAtText}}</view>
      <button class="btn-outline key-btn" bindtap="onReplaceKey">更换 KEY</button>
    </block>
  </view>

  <!-- 菜单 -->
  <view class="nina-card menu-card">
    <view class="menu-item" bindtap="onMore">
      <view>更多</view>
      <view class="arrow">→</view>
    </view>
    <view class="menu-item" bindtap="goSetting">
      <view>设置</view>
      <view class="arrow">→</view>
    </view>
  </view>

  <t-toast id="t-toast" />
</view>
